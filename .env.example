# ============================================================
# Jevi Store — Local Environment Example
# ============================================================

# Browser-side API
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8787
NEXT_PUBLIC_D1_WORKER_URL=http://127.0.0.1:8787

# Next.js server-side API
API_BASE=http://host.docker.internal:8787
API_PROXY=http://host.docker.internal:8787
AUTH_UPSTREAM=http://host.docker.internal:8787
D1_WORKER_INTERNAL_BASE=http://host.docker.internal:8787

# Strapi
STRAPI_URL=http://127.0.0.1:1337
NEXT_PUBLIC_STRAPI_URL=http://127.0.0.1:1337
STRAPI_API_TOKEN=

# PayPal browser SDK
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Active storefront
NEXT_PUBLIC_STOREFRONT_CODE=AU

# Brand and public website
NEXT_PUBLIC_SITE_URL=https://jeviapparelstudio.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@jeviapparelstudio.com

# Authentication
AUTH_SECRET=change-me-local-auth-secret-at-least-32-characters

ENABLE_BRAINTREE=false